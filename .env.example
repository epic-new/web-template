# Base URL of the app (used by Better Auth and cross-subdomain cookie derivation)
# When running inside Daytona via proxy, this is set automatically by Behave.
# Cookie domain and trusted origins are derived from this URL:
#   https://8080-xxx.proxy.epic.new → cookie domain "epic.new", trusts "https://epic.new"
#   https://8080-xxx.lvh.me:1234   → cookie domain "lvh.me", trusts "https://lvh.me"
#   http://localhost:8080           → no cross-domain (local dev)
NEXT_PUBLIC_BASE_URL=http://localhost:8080

# Optional. The Epic workspace origin the preview bridge
# (components/preview-bridge.tsx) will talk to over postMessage. Unset, it
# accepts epic.new, lvh.me and localhost.
# NEXT_PUBLIC_PREVIEW_HOST_ORIGIN=

# Auth secret (generated automatically by Behave for sandboxes)
BETTER_AUTH_SECRET=

# Database (SQLite for dev, Turso for production)
DATABASE_URL="file:./db/databases/development.db"

# Optional — only for a production deploy on Vercel. Development uses the
# SQLite DATABASE_URL above; set this when a Turso database is provisioned.
# TURSO_DATABASE_TOKEN=

# Optional — Epic Replay runtime policy (server-only; never NEXT_PUBLIC_).
# Read by GET /api/epic/replay/config. Unset, the policy is disabled with
# reason "not_configured" and the app runs normally with capture off.
# EPIC_API_URL=https://build.epic.new
# EPIC_PROJECT_ID=
# EPIC_PUBLISHING_TOKEN=
# Overrides VERCEL_ENV / NODE_ENV: production | preview | development | test
# EPIC_ENVIRONMENT=
# Tags new recordings; falls back to VERCEL_GIT_COMMIT_SHA.
# EPIC_RELEASE=
