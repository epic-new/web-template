# Base URL of the app (used by Better Auth). On an Epic machine it is set to
# the preview's own address. An https URL also turns on the cookies a framed
# preview needs (Secure, SameSite=None, Partitioned).
NEXT_PUBLIC_BASE_URL=http://localhost:8080

# Optional. Other origins Better Auth trusts, comma-separated. Epic sets it on
# the machines it runs; a local run needs none.
# BETTER_AUTH_TRUSTED_ORIGINS=

# Optional. Hosts allowed to load `next dev`'s own resources, comma-separated
# (Next's `allowedDevOrigins`). Epic sets it on the machines it runs.
# EPIC_DEV_ORIGINS=

# Optional. The workspace origins the preview bridge
# (components/preview-bridge.tsx) will talk to over postMessage,
# comma-separated. Epic sets it on the machines it runs; unset, only a
# localhost workspace is trusted.
# NEXT_PUBLIC_PREVIEW_HOST_ORIGIN=

# Auth secret (generated automatically by Behave for sandboxes)
BETTER_AUTH_SECRET=

# Database (SQLite for dev, Turso for production)
DATABASE_URL="file:./db/databases/development.db"

# Optional — only for a production deploy on Vercel. Development uses the
# SQLite DATABASE_URL above; set this when a Turso database is provisioned.
# TURSO_DATABASE_TOKEN=

# Optional — Epic Replay runtime policy (server-only; never NEXT_PUBLIC_).
# Read by GET /api/epic/replay/config. Unset, the policy is disabled with
# reason "not_configured" and the app runs normally with capture off.
# EPIC_API_URL=https://build.epic.new
# EPIC_PROJECT_ID=
# EPIC_PUBLISHING_TOKEN=
# Epic's OTLP ingest base for session replay, evidence and server traces.
# Unset, it is ${EPIC_API_URL}/api/observability. https (or http://localhost
# outside production); an invalid value leaves telemetry and tracing off.
# EPIC_OTLP_ENDPOINT=
# Overrides VERCEL_ENV / NODE_ENV: production | preview | development | test.
# When set, it must be one of those exactly; an empty or invalid value keeps
# replay disabled rather than falling back.
# EPIC_ENVIRONMENT=
# Tags new recordings; falls back to VERCEL_GIT_COMMIT_SHA.
# EPIC_RELEASE=
# Only when EPIC_API_URL points at an Epic behind Vercel Deployment
# Protection (staging): sent as x-vercel-protection-bypass on every call.
# EPIC_VERCEL_PROTECTION_BYPASS=

# Optional — Epic Replay recording and bug reports (server-only). The browser
# sends OTLP through this app's own /api/epic/replay routes, which relay to Epic
# with the credential above. The opaque subject Epic sees is an HMAC of the
# user id under EPIC_REPLAY_SECRET (BETTER_AUTH_SECRET when unset), so keep
# that secret stable: rotating it changes every subject. Rotating
# EPIC_PUBLISHING_TOKEN does not.
# EPIC_REPLAY_SECRET=
# Anonymous (signed-out) recording and reporting are OFF unless set to `allow`;
# they identify a visitor by a signed, HttpOnly cookie scoped to /api/epic/replay.
# EPIC_REPLAY_ANONYMOUS_CAPTURE=allow
# EPIC_REPLAY_ANONYMOUS_REPORTING=allow
