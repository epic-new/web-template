{
  "name": "agents",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 8080 --turbopack",
    "preview": "next dev --turbopack -p",
    "dev:start": "mkdir -p logs && nohup bun run dev > logs/dev.log 2>&1 &",
    "dev:logs": "tail -f logs/dev.log",
    "dev:restart": "pkill -f 'next dev -p 8080' || true && sleep 1 && bun run dev:start",
    "dev:stop": "pkill -f 'next dev -p 8080' || true",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "npx tsgo --noEmit --skipLibCheck",
    "test": "NODE_ENV=test vitest run",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "bun db/scripts/seed.ts",
    "db:clean": "bun db/scripts/clean.ts",
    "db:squash": "bun db/scripts/squash.ts",
    "db:reset": "bun db/scripts/clean.ts && bun run db:push",
    "shadcn:add": "shadcn add"
  },
  "dependencies": {
