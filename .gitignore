# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.


# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Lock files from other package managers (we use bun)
package-lock.json
yarn.lock
pnpm-lock.yaml

# testing
/coverage
/test-results/

# next.js
/.next/
/.next-verify/
/.swc/
/out/

# production
/build

# misc
.DS_Store
*.pem

.jobs/

# drizzle-gateway
lib/drizzle-gateway/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
bun-debug.log*
logs/

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Generated test-user credentials (random passwords) — committed as an empty
# stub; local copies are kept out of git via `git update-index --skip-worktree`.
/db/seed/.credentials/

# database
/db/*.db
/db/*.db-shm
/db/*.db-wal
/db/databases/*.db
/db/databases/*.db-shm
/db/databases/*.db-wal

# Epic CLI worktrees
.worktrees

# Sandbox-runtime mutated files ("template esteril" — three-worlds map).
# Runtime-mutable => untracked + gitignored + generated at provision.
/ecosystem.config.js
/.epic/settings.json
/.epic/settings.local.json

# The harness's own bootstrap and per-session state, baked/written beside this
# checkout by the sandbox image — never part of the project. No trailing slash
# on either: `.harness-bootstrap` is a real directory beside a plain checkout
# but a *symlink* inside a prototype screen's worktree (see epic-build's
# screen-git.ts), and a trailing slash ("directory only") would miss the
# symlink shape and let `git add -A` stage it — which is exactly how one
# build committed a 250MB+ file from its pnpm store and got its push rejected
# by GitHub's size limit.
.harness-bootstrap
.agent-runs

__pycache__/
